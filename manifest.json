{
  "name": "YTPop",
  "version": "0.10.0",
  "description": "YouTube enhancements, made by Inventionpro",
  "icons": {
    "16": "src/img/icon-16.png",
    "32": "src/img/icon-32.png",
    "64": "src/img/icon-64.png",
    "128": "src/img/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://youtube.com/*",
    "*://www.youtube.com/*",
    "*://gaming.youtube.com/*",
    "*://m.youtube.com/*",
    "*://mobile.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://youtube.com/*", "*://www.youtube.com/*", "*://gaming.youtube.com/*", "*://m.youtube.com/*", "*://mobile.youtube.com/*"],
      "js": ["src/js/content.js"]
    }
  ],
  "action": {
    "default_popup": "src/page/popup.html",
    "default_icon": {
      "16": "src/img/icon-16.png",
      "32": "src/img/icon-32.png",
      "64": "src/img/icon-64.png"
    }
  },
  "commands": {
    "enabled": {
      "description": "Enable/Disable player modifier"
    },
    "noads": {
      "description": "Enable/Disable no static ads modifier"
    },
    "novideoads": {
      "description": "Enable/Disable no video ads modifier"
    }
  },
  "manifest_version": 3
}